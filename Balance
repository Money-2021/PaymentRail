 [TestMethod]
 public void UseCase_coin_balance()
 {
     Set_AUD();


     string folder = Environment.GetEnvironmentVariable("Envionment");
     string _userSecureIdentity = Environment.GetEnvironmentVariable("SinA");
     string userTokenPath = @"D:\Examples\" + node + @"\" + folder + "\\Token-" + _userSecureIdentity + ".json";
     Fido.FidoProvider fp = new Fido.FidoProvider(userTokenPath);
     string userToken = fp.GetJwToken();

     // Extract Function endpoint from User Token
     var securityToken = new JwtSecurityToken(userToken);
     Uri _baseUri = new Uri(securityToken.Audiences.FirstOrDefault());
     HttpClient _httpClient = new HttpClient();
     string _relativeUrl = "api/Balance";
     Uri _uri = new Uri(_baseUri, _relativeUrl);
     _httpClient.BaseAddress = _baseUri;
     _httpClient.DefaultRequestHeaders.Add("x-token", userToken);
     // Build auth signature
     string shash = userToken + fp.GetSecureIdentity();
     string ssign = fp.Sign(shash);
     _httpClient.DefaultRequestHeaders.Add("x-jws-signature", ssign);
     HttpResponseMessage response = _httpClient.GetAsync(_uri).Result;
     if (response.IsSuccessStatusCode)
     {
         // Balance
         string jwToken = response.Content.ReadAsStringAsync().Result;
         decimal balance = decimal.Parse(jwToken);
         Debug.WriteLine("Balance:", balance.ToString("N2"));
     }
     else
     {
         string sError = response.Content.ReadAsStringAsync().Result;
         throw new Exception(sError);
     }

 }
